{
  "name": "neraca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @neraca/web",
    "build": "npm run build -w @neraca/web",
    "preview": "npm run preview -w @neraca/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "verify": "npm run typecheck && npm run test && npm run build && npm run budget",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "smoke": "playwright test -c playwright.smoke.config.ts",
    "budget": "node scripts/check-bundle-size.mjs",
    "verify:full": "npm run verify && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
